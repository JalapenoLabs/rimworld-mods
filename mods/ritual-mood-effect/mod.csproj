<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net480</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>

		<RootNamespace>RitualMoodEffect</RootNamespace>
		<AssemblyName>RitualMoodEffect</AssemblyName>
		<OutputPath>1.6/Assemblies</OutputPath>
		<VersionPrefix>0.1.0.0</VersionPrefix>

		<!-- Do not generate pdb file -->
		<DebugType>none</DebugType>

		<!-- net480 defaults to C# 7.3; override to allow modern syntax -->
		<LangVersion>latest</LangVersion>

		<DebugSymbols>false</DebugSymbols>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<!-- Mod -->
		<Compile Include="1.6/Source/*" />

		<!-- Rimworld: references the shared root-level RimworldForCICD submodule -->
		<Reference Include="../../RimworldForCICD/Managed/*.dll">
			<Private>False</Private>
		</Reference>

		<!-- Harmony: references the shared root-level binaries -->
		<Reference Include="../../binaries/0Harmony.dll">
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>
