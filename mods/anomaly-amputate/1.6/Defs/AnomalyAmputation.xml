<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Gorehulk" and not(recipes)]</xpath>
        <value>
          <recipes />
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Gorehulk"]/recipes</xpath>
        <value>
          <li>Anesthetize</li>
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Gorehulk"]/recipes</xpath>
        <value>
          <li>RemoveBodyPart</li>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
