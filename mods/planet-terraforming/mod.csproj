<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net480</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>

		<RootNamespace>Terraformation</RootNamespace>
		<AssemblyName>Terraformation</AssemblyName>
		<OutputPath>1.6/Assemblies</OutputPath>
		<VersionPrefix>0.1.0.0</VersionPrefix>

		<!-- Do not generate pdb file -->
		<DebugType>none</DebugType>

		<LangVersion>latest</LangVersion>
		<DebugSymbols>false</DebugSymbols>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<!-- Mod — recursive glob so any subfolder under Source is compiled without csproj edits -->
		<Compile Include="1.6/Source/**/*.cs" />

		<!-- Rimworld — references the shared root-level RimworldForCICD submodule -->
		<Reference Include="../../RimworldForCICD/Managed/*.dll">
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>
