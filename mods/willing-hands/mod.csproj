<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net480</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>

		<RootNamespace>WillingHands</RootNamespace>
		<AssemblyName>WillingHands</AssemblyName>
		<OutputPath>1.6/Assemblies</OutputPath>
		<VersionPrefix>0.1.0.0</VersionPrefix>

		<!-- Do not generate pdb file -->
		<DebugType>none</DebugType>

		<LangVersion>latest</LangVersion>
		<DebugSymbols>false</DebugSymbols>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<!-- Mod -->
		<Compile Include="1.6/Source/*" />

		<!-- Rimworld — references the shared root-level RimworldForCICD submodule.
		     RimWorld compiles all DLC (including Ideology's slavery system) into
		     Assembly-CSharp.dll, so no separate Ideology reference is needed. -->
		<Reference Include="../../RimworldForCICD/Managed/*.dll">
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>
