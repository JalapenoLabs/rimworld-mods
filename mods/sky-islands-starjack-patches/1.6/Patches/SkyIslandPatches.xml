<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- All patches target Odyssey defs; gate on Odyssey so nothing errors if the
       DLC is somehow absent. Sky-island detection itself happens at runtime in
       C#, so these edits are inert unless a pawn is actually on a sky island. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Ludeon.RimWorld.Odyssey</li>
    </mods>
    <match>
      <Operation Class="PatchOperationSequence">
        <operations>

          <!-- Shipborn "Planetary habitat" mood (-2): neutral on a sky island. -->
          <li Class="PatchOperationReplace">
            <xpath>/Defs/ThoughtDef[defName="SpaceHabitat_Mood"]/workerClass</xpath>
            <value>
              <workerClass>SkyIslandsStarjackPatches.ThoughtWorker_Precept_SpaceHabitat_SkyIslandNeutral</workerClass>
            </value>
          </li>

          <!-- Low-gravity-adapted planetside penalty: halved on a sky island by
               adding a counteracting +0.1 move / +0.05 work offset there. -->
          <li Class="PatchOperationAdd">
            <xpath>/Defs/GeneDef[defName="MoveSpeed_Space"]/conditionalStatAffecters</xpath>
            <value>
              <li Class="SkyIslandsStarjackPatches.ConditionalStatAffecter_OnSkyIsland">
                <statOffsets>
                  <MoveSpeed>0.1</MoveSpeed>
                  <WorkSpeedGlobal>0.05</WorkSpeedGlobal>
                </statOffsets>
              </li>
            </value>
          </li>

        </operations>
      </Operation>
    </match>
  </Operation>

</Patch>
