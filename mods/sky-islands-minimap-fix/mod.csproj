<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net480</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>

		<RootNamespace>SkyIslandsMinimapFix</RootNamespace>
		<AssemblyName>SkyIslandsMinimapFix</AssemblyName>
		<OutputPath>1.6/Assemblies</OutputPath>
		<VersionPrefix>0.1.0.0</VersionPrefix>

		<!-- Do not generate pdb file -->
		<DebugType>none</DebugType>

		<LangVersion>latest</LangVersion>
		<DebugSymbols>false</DebugSymbols>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<!-- Mod -->
		<Compile Include="1.6/Source/*" />

		<!-- Rimworld — references the shared root-level RimworldForCICD submodule. -->
		<Reference Include="../../RimworldForCICD/Managed/*.dll">
			<Private>False</Private>
		</Reference>

		<!-- Harmony — shared copy from the root-level binaries folder. Dubs Mint
		     Minimap is reached by reflection (AccessTools), so it is not
		     referenced at compile time. -->
		<Reference Include="../../binaries/0Harmony.dll">
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>
