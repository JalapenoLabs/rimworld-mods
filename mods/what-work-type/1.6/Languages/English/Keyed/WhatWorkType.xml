<?xml version="1.0" encoding="utf-8" ?>
<LanguageData>

  <!-- Row label in the Building section of the info card. -->
  <WhatWorkType.Label>Work type</WhatWorkType.Label>

  <!-- Hover text heading, explaining what the row means. -->
  <WhatWorkType.Desc>The Work tab column colonists use to operate this building. Raise that work type's priority to get it used; the skill decides how well they do it.</WhatWorkType.Desc>

  <!-- One line per job. {0} job name, {1} work type, {2} skills, {3} this job's rank, {4} jobs in the work type. -->
  <WhatWorkType.Job>{0}: {1} (skill: {2}). Done {3} of {4} among {1} jobs.</WhatWorkType.Job>

  <!-- Stands in for the skill list on work types that train no skill, such as hauling. -->
  <WhatWorkType.NoSkill>none</WhatWorkType.NoSkill>

</LanguageData>
